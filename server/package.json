{
  "name": "@pear/server",
  "version": "0.1.0",
  "private": true,
  "description": "Pear server: headless @pear/core behind a WebSocket, serving Pear as a PWA",
  "main": "dist/server.js",
  "bin": {
    "pear-server": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node dist/cli.js",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@pear/core": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
